<?jelly escape-by-default='true'?>
<!--
  The welcome page. Everything on it is computed for the person looking at it (InstanceOverview,
  LearningPath, StartHereEntry), and every piece of text, including the curated welcome message and
  notes, is written escaped. No inline script: behaviour lives in welcome.js and tour.js.
-->
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="${it.displayName}" type="one-column">
    <l:main-panel>
      <j:set var="o" value="${it.overview}"/>
      <div class="concierge" id="concierge-welcome"
           data-progress-url="${rootURL}/${it.urlName}/progress"
           data-logged-in="${it.loggedIn}">

        <div class="concierge-hero">
          <p class="concierge-eyebrow">Concierge</p>
          <l:app-bar title="${%Welcome to this Jenkins}">
            <j:if test="${it.canManageTours}">
              <a class="jenkins-button" href="manage">${%Edit welcome and start here}</a>
            </j:if>
            <j:if test="${it.administrator}">
              <a class="jenkins-button" href="usage">${%Assistant usage}</a>
            </j:if>
          </l:app-bar>
          <j:choose>
            <j:when test="${!empty(it.welcomeMessage)}">
              <p class="concierge-welcome">${it.welcomeMessage}</p>
            </j:when>
            <j:otherwise>
              <p class="concierge-welcome">${%intro}</p>
            </j:otherwise>
          </j:choose>
        </div>

        <section class="concierge-section" aria-labelledby="concierge-overview-title">
          <h2 id="concierge-overview-title">${%At a glance}</h2>
          <!-- The charts are SVG with positions in attributes, computed by InstanceOverview: no
               inline styles and no chart library. The text next to them says the same thing. -->
          <div class="concierge-glance">
            <div class="concierge-card concierge-health">
              <p class="concierge-card__headline">
                <span class="concierge-card__number">${o.jobCount}</span> ${%jobs you can see}
              </p>
              <j:set var="segments" value="${o.healthSegments}"/>
              <j:if test="${!segments.isEmpty()}">
                <svg class="concierge-health__bar" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  <j:forEach var="s" items="${segments}">
                    <rect class="concierge-fill concierge-fill--${s.status}" x="${s.start}" y="0" width="${s.width}" height="10">
                      <title>${s.count} ${s.label}</title>
                    </rect>
                  </j:forEach>
                </svg>
                <ul class="concierge-legend">
                  <j:forEach var="s" items="${segments}">
                    <li>
                      <span class="concierge-status concierge-status--${s.status}" aria-hidden="true"/>
                      <j:choose>
                        <j:when test="${s.status == 'failure'}">
                          <a href="#concierge-failing-title"><strong>${s.count}</strong> ${s.label}</a>
                        </j:when>
                        <j:otherwise>
                          <span><strong>${s.count}</strong> ${s.label}</span>
                        </j:otherwise>
                      </j:choose>
                    </li>
                  </j:forEach>
                </ul>
              </j:if>
            </div>

            <div class="concierge-card concierge-ring-card">
              <svg class="concierge-ring concierge-ring--executors" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                <circle class="concierge-ring__track" cx="18" cy="18" r="15.9155"/>
                <circle class="concierge-ring__value" cx="18" cy="18" r="15.9155"
                        stroke-dasharray="${o.busyExecutorsPercent} 100" transform="rotate(-90 18 18)"/>
              </svg>
              <div>
                <p class="concierge-card__headline">
                  <span class="concierge-card__number">${o.busyExecutors}/${o.executors}</span> ${%executors busy}
                </p>
                <p class="concierge-muted">${%queue(o.queueLength)}</p>
                <p class="concierge-muted">${%building(o.building.size())}</p>
              </div>
            </div>

            <div class="concierge-card concierge-ring-card">
              <svg class="concierge-ring concierge-ring--agents" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                <circle class="concierge-ring__track" cx="18" cy="18" r="15.9155"/>
                <circle class="concierge-ring__value" cx="18" cy="18" r="15.9155"
                        stroke-dasharray="${o.agentsOnlinePercent} 100" transform="rotate(-90 18 18)"/>
              </svg>
              <div>
                <p class="concierge-card__headline">
                  <span class="concierge-card__number">${o.agentsOnline}/${o.agentCount}</span> ${%agents online}
                </p>
              </div>
            </div>
          </div>
          <j:if test="${o.pluginsVisible}">
            <p class="concierge-muted concierge-glance__plugins">${o.pluginCount} ${%plugins.label(o.pluginUpdates)}</p>
          </j:if>
        </section>

        <j:set var="startHere" value="${it.startHere}"/>
        <j:if test="${!startHere.isEmpty()}">
          <section class="concierge-section" aria-labelledby="concierge-start-title">
            <h2 id="concierge-start-title">${%Start here}</h2>
            <ol class="concierge-pinned">
              <j:forEach var="entry" items="${startHere}">
                <li>
                  <a href="${rootURL}/${entry.job.url}" class="concierge-job">
                    <span class="concierge-status concierge-status--${entry.job.status}" aria-hidden="true"/>
                    ${entry.job.displayName}
                  </a>
                  <j:if test="${!empty(entry.note)}">
                    <p class="concierge-note">${entry.note}</p>
                  </j:if>
                </li>
              </j:forEach>
            </ol>
          </section>
        </j:if>

        <section class="concierge-section" aria-labelledby="concierge-tours-title">
          <h2 id="concierge-tours-title">${%Guided tours}</h2>
          <p class="concierge-muted">${%tours.intro}</p>
          <ul class="concierge-tours">
            <j:forEach var="tour" items="${it.tours}">
              <li class="concierge-tour">
                <h3>${tour.title}</h3>
                <div class="concierge-tour__text">${tour.text}</div>
                <button type="button" class="jenkins-button jenkins-button--primary" data-concierge-tour="${tour.id}">
                  ${%Start the tour}
                </button>
              </li>
            </j:forEach>
          </ul>
        </section>

        <section class="concierge-section concierge-paths" aria-labelledby="concierge-paths-title">
          <h2 id="concierge-paths-title">${%Learning paths}</h2>
          <j:if test="${!it.loggedIn}">
            <p class="concierge-muted">${%Sign in to keep track of the steps you have done.}</p>
          </j:if>
          <p class="concierge-error" id="concierge-progress-error" hidden="hidden" role="alert"/>
          <div class="concierge-path-grid">
            <j:forEach var="path" items="${it.paths}">
              <!-- The done class shows the Completed badge; welcome.js keeps it in step with the checkboxes. -->
              <article class="concierge-path ${path.doneCount == path.steps.size() ? 'concierge-path--done' : ''}" data-path="${path.id}">
                <header>
                  <h3>${path.title}</h3>
                  <span class="concierge-path__badge">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="m9.5 16.2-4.2-4.2-1.4 1.4 5.6 5.6L21 7.4 19.6 6z"/>
                    </svg>
                    ${%Completed}
                  </span>
                  <span class="concierge-path__count" data-path-count="${path.id}">${path.doneCount}/${path.steps.size()}</span>
                </header>
                <p class="concierge-muted">${path.intro}</p>
                <ol class="concierge-steps">
                  <j:forEach var="step" items="${path.steps}">
                    <li class="concierge-step">
                      <div class="concierge-step__body">
                        <h4>${step.title}</h4>
                        <p>${step.text}</p>
                        <j:choose>
                          <j:when test="${step.href != null}">
                            <p><a href="${rootURL}/${step.href}">${%Show me}</a></p>
                          </j:when>
                          <j:otherwise>
                            <p class="concierge-muted">${%Nothing to show for this on this instance yet.}</p>
                          </j:otherwise>
                        </j:choose>
                      </div>
                      <j:if test="${it.loggedIn}">
                        <span class="jenkins-checkbox concierge-step__done">
                          <input type="checkbox" id="concierge-step-${path.id}-${step.id}"
                                 data-step="${step.id}" data-path="${path.id}" checked="${step.done ? 'true' : null}"/>
                          <label for="concierge-step-${path.id}-${step.id}">${%Done}</label>
                        </span>
                      </j:if>
                    </li>
                  </j:forEach>
                </ol>
              </article>
            </j:forEach>
          </div>
        </section>

        <div class="concierge-columns">
          <section class="concierge-section" aria-labelledby="concierge-failing-title">
            <h2 id="concierge-failing-title">${%Failing now}</h2>
            <j:choose>
              <j:when test="${o.failing.isEmpty()}">
                <p class="concierge-muted">${%Nothing you can see is failing.}</p>
              </j:when>
              <j:otherwise>
                <ul class="concierge-joblist">
                  <j:forEach var="job" items="${o.failing}">
                    <li><a href="${rootURL}/${job.url}" class="concierge-job"><span class="concierge-status concierge-status--${job.status}" aria-hidden="true"/>${job.displayName}</a></li>
                  </j:forEach>
                </ul>
              </j:otherwise>
            </j:choose>
          </section>

          <section class="concierge-section" aria-labelledby="concierge-recent-title">
            <h2 id="concierge-recent-title">${%Recently built}</h2>
            <j:choose>
              <j:when test="${o.recent.isEmpty()}">
                <p class="concierge-muted">${%No builds yet.}</p>
              </j:when>
              <j:otherwise>
                <ul class="concierge-joblist">
                  <j:forEach var="job" items="${o.recent}">
                    <li><a href="${rootURL}/${job.url}" class="concierge-job"><span class="concierge-status concierge-status--${job.status}" aria-hidden="true"/>${job.displayName}</a></li>
                  </j:forEach>
                </ul>
              </j:otherwise>
            </j:choose>
          </section>

          <j:if test="${!o.folders.isEmpty()}">
            <section class="concierge-section" aria-labelledby="concierge-folders-title">
              <h2 id="concierge-folders-title">${%How it is organised}</h2>
              <ul class="concierge-joblist">
                <j:forEach var="folder" items="${o.folders}">
                  <li><a href="${rootURL}/${folder.url}">${folder.name}</a><span class="concierge-muted">&#160;${%jobs(folder.jobCount)}</span></li>
                </j:forEach>
              </ul>
            </section>
          </j:if>
        </div>
      </div>
      <script src="${resURL}/plugin/concierge/js/welcome.js" type="text/javascript"/>
    </l:main-panel>
  </l:layout>
</j:jelly>
