<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:section title="${%Concierge assistant}">
    <f:entry field="enabled">
      <f:checkbox title="${%Enable the AI assistant}"/>
    </f:entry>
    <f:entry title="${%Provider}" field="provider">
      <f:select/>
    </f:entry>
    <f:entry title="${%Model}" field="model">
      <f:textbox/>
    </f:entry>
    <f:entry title="${%API key}" field="credentialsId">
      <c:select/>
    </f:entry>
    <f:entry title="${%Base URL}" field="baseUrl">
      <f:textbox/>
    </f:entry>
    <f:entry field="allowDeepSeek">
      <f:checkbox title="${%Allow DeepSeek, whose hosted API stores data in China}"/>
    </f:entry>
    <f:validateButton title="${%Test connection}" progress="${%Testing...}" method="testConnection"
                      with="provider,model,credentialsId,baseUrl,allowDeepSeek"/>

    <f:entry title="${%What the assistant may see}" field="shareLogs" description="${%sharing.description}">
      <f:checkbox title="${%Build logs, with secrets removed}"/>
    </f:entry>
    <f:entry field="shareConfiguration">
      <f:checkbox title="${%Job configuration: parameters, defaults and triggers}"/>
    </f:entry>
    <f:entry field="shareScm">
      <f:checkbox title="${%Source control: repositories and commit messages}"/>
    </f:entry>
    <f:entry title="${%Most log lines per request}" field="maxLogLines">
      <f:number clazz="positive-number" min="1" max="2000" default="200"/>
    </f:entry>
    <f:entry title="${%Questions per user per hour}" field="requestsPerHour">
      <f:number clazz="positive-number" min="1" default="30"/>
    </f:entry>
    <f:entry title="${%Most tool calls per question}" field="maxToolCalls">
      <f:number clazz="positive-number" min="1" max="20" default="8"/>
    </f:entry>
    <f:entry field="allowUserKeys">
      <f:checkbox title="${%Let users bring their own API key for this provider}"/>
    </f:entry>
  </f:section>
</j:jelly>
