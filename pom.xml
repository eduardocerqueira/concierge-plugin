<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2221.va_045130417c9</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>concierge</artifactId>
  <version>${changelist}</version>
  <packaging>hpi</packaging>

  <name>Concierge</name>
  <description>Onboarding tours and an optional AI assistant that know this Jenkins instance, and show each person only what they are already allowed to see.</description>
  <url>https://github.com/jenkinsci/${project.artifactId}-plugin</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/${gitHubRepo}.git</connection>
    <developerConnection>scm:git:git@github.com:${gitHubRepo}.git</developerConnection>
    <tag>${scmTag}</tag>
    <url>https://github.com/${gitHubRepo}</url>
  </scm>

  <properties>
    <changelist>999999-SNAPSHOT</changelist>
    <!-- Points at the personal repository until hosting is granted; becomes
         jenkinsci/concierge-plugin when the repository moves. -->
    <gitHubRepo>eduardocerqueira/concierge-plugin</gitHubRepo>

    <!-- Guard rails required for hosting. Each turns a class of accident into a build failure:
         bundling a third-party library by mistake, keeping a dependency override that a newer BOM
         made redundant, reaching for JUnit 4, or using a deprecated Stapler or commons-lang 2 API
         that Jenkins core already provides a replacement for. -->
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
    <banObsoleteDependencyOverrides.skip>false</banObsoleteDependencyOverrides.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <ban-deprecated-stapler.skip>false</ban-deprecated-stapler.skip>
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>

    <!-- The parent pom skips the formatting check by default. Enforced here so that "formatted" is
         part of the gate rather than a claim. `mvn spotless:apply` fixes anything it complains about. -->
    <spotless.check.skip>false</spotless.check.skip>

    <!-- Jenkins baseline: the newest LTS line, the same as Live Wall. -->
    <jenkins.baseline>2.568</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.3</jenkins.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <version>7216.v6cb_72de2015d</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <!-- No plugin dependencies yet. Phase 1 (onboarding) needs only Jenkins core; the Credentials
       plugin arrives with the assistant in phase 2. See docs/roadmap.md. -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Test controllers do not need an agent listener, and leaving it on can hang shutdown
                 on machines whose hostname resolves to an address they cannot connect back to. -->
            <jenkins.model.Jenkins.slaveAgentPort>-1</jenkins.model.Jenkins.slaveAgentPort>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
